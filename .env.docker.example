# Public entrypoint: http://localhost:APP_PORT
APP_PORT=3000

# Linux: replace with `id -u` and `id -g` if your account is not 1000.
# Docker Desktop on Windows/macOS can keep these defaults.
HOST_UID=1000
HOST_GID=1000

# Internal gateway -> backend key. Use a long random alphanumeric value.
# PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
API_KEY=replace-with-a-long-random-value

# Names created inside the persistent Ollama volume.
GENERATOR_MODEL_NAME=acne-generator
INTAKE_MODEL_NAME=acne-intaker

# Ollama runs the GGUF models. Keep embedding + reranker on CPU by default.
DEVICE=cpu
LLM_KEEP_ALIVE=-1
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
OLLAMA_HEALTH_TIMEOUT=10
OLLAMA_GENERATE_TIMEOUT=300
INTAKE_TIMEOUT=120

RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
OLLAMA_IMAGE_TAG=latest
