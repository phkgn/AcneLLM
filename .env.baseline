# ============================================================
# .env — CHỈ: secret + giá trị khác theo máy/lần chạy.
# Mọi hằng số tuning ở src/acne_llm/config.py. Đừng copy vào đây.
# Không điền secret thật vào file template này.
# ============================================================

# ── Secrets (KHÔNG commit giá trị thật) ──────────────────────
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DATAGEN_API_KEY=
API_KEY=

# ── Máy này ──────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
DEVICE=cpu
LOG_LEVEL=DEBUG

# ── Model đang chạy (đổi theo lần build / theo arm X-Y-Z-W) ──
LLM_MODEL=acne-generator
INTAKE_MODE=unified
INTAKE_MODEL=acne-intaker

# ── Judge (eval) ─────────────────────────────────────────────
JUDGE_PROVIDER=deepseek
JUDGE_MODEL=deepseek-v4-pro

# ── Datagen (đọc riêng qua os.environ) ───────────────────────
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Deploy ───────────────────────────────────────────────────
CORS_ORIGINS=["*"]
