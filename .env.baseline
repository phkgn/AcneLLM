# ============================================================
# .env.baseline — Tất cả params có thể tuning cho AcneLLM
# Đây là file duy nhất cần chỉnh khi thay đổi cấu hình chạy.
# Copy thành .env để dùng: cp .env.baseline .env
# API keys (DEEPSEEK, OPENAI) điền vào .env, KHÔNG commit vào .env.baseline
# ============================================================

# ── Logging ──────────────────────────────────────────────────
# DEBUG = thấy từng bước pipeline (retrieval, rerank, LLM latency)
# INFO  = production, ít noise hơn
LOG_LEVEL=DEBUG

# ── LLM (Ollama) ─────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
# Model chính — đặt tên model đã pull trong Ollama
LLM_MODEL=acne-qwen25:7b
# Fallback nếu model chính không load được
LLM_FALLBACK_MODEL=qwen2.5:3b
# Context window (tokens). 2048 = đủ cho acne chatbot; giảm prefill latency ~30%
# Tăng lên 3072-4096 nếu cần history dài hoặc context RAG lớn
LLM_NUM_CTX=2048
# Số token tối đa model sinh ra mỗi lượt
# Câu trả lời acne thực tế ~150-350 tokens; 500 là buffer an toàn
# Với 10-20 tok/s trên 4GB VRAM: 900→500 tiết kiệm ~8-20s worst case
LLM_NUM_PREDICT=500
# Temperature chat: 0.0 = chắc chắn, 1.0 = sáng tạo
# Override per-request từ frontend settings (query param ?temperature=)
LLM_TEMPERATURE=0.2
# True khi model fine-tune đã nhúng SYSTEM prompt vào Modelfile
# → không gửi system message qua API, tránh 2 system prompt chồng nhau
LLM_USE_MODELFILE_SYSTEM=true
OLLAMA_HEALTH_TIMEOUT=5
OLLAMA_GENERATE_TIMEOUT=180

# ── Embedding & Reranker ─────────────────────────────────────
# Embedder cho tiếng Việt (dim=1024)
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
# Cross-encoder reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# cpu hoặc gpu (cuda)
DEVICE=cpu
# Giảm batch size để tránh OOM trên CPU; 8 đủ cho pool 5-8 chunks
RERANKER_BATCH_SIZE=8
RERANKER_CACHE_SIZE=2048
# Sigmoid threshold loại chunk yếu sau cross-encoder (0.0–1.0)
RERANKER_MIN_SIGMOID=0.30

# ── Retrieval (pipeline thường, non-chat) ────────────────────
# Pool trước rerank
RETRIEVE_TOP_K=8
# Giữ lại sau cross-encoder
RERANK_TOP_K=3

# ── Retrieval (chat stream) ──────────────────────────────────
# Pool nhỏ hơn vì latency quan trọng hơn trong chat
# 5 chunks → reranker chạy 5 pairs thay vì 8, tiết kiệm ~30-40% rerank time
CHAT_RETRIEVE_TOP_K=5
CHAT_RERANK_TOP_K=3
# Giảm context chars để prompt ngắn hơn → prefill LLM nhanh hơn
# 2500 chars ~ 700 tokens context = vẫn đủ cho 2-3 chunks chất lượng
CHAT_MAX_CONTEXT_CHARS=2500
# Sigmoid tối thiểu để chunk xuất hiện trong citation
CHAT_MIN_CITATION_SCORE=0.12
# Safety pool (guideline chunks cho thai kỳ, thuốc kê đơn)
CHAT_SAFETY_TOP_K=5
# True = gọi LLM clinical planner trước khi retrieve (chậm hơn nhưng chính xác hơn)
CHAT_USE_LLM_PLANNER=true

# ── Dense retrieval ──────────────────────────────────────────
# Cosine distance threshold Chroma (0.60 ≈ similarity 0.40)
# Tăng = lấy nhiều hơn nhưng noise hơn; giảm = chặt hơn, ít kết quả hơn
DENSE_MAX_DISTANCE=0.60
BM25_NORMALIZE=true
QUERY_EXPANSION_TEMPERATURE=0.1
ENGLISH_INPUT_NOTICE=true

# ── Guardrails ───────────────────────────────────────────────
GUARDRAILS_ENABLE_OOD=true
# OOD threshold: cosine sim query vs acne centroid
# < threshold → out-of-domain. 0.25 = conservative; 0.30-0.35 = chặt hơn
GUARDRAILS_OOD_THRESHOLD=0.25
# soft = LLM tự xử lý | hard = refusal cứng | off = tắt
GUARDRAILS_SCOPE_MODE=soft

# ── Cache (DiskCache) ────────────────────────────────────────
# Thu muc disk cache cho embedding vectors va retrieval results
CACHE_DIR=./data/cache
# Dung luong toi da tinh bang GB (0 = tat cache)
CACHE_SIZE_GB=2.0

# ── Session store (JSONL) ────────────────────────────────────
# Thư mục chứa session files (một .jsonl per session_id)
SESSIONS_DIR=./data/sessions
# Thời gian idle (giây) trước khi session bị expire và xoá
SESSION_TTL=1800

# ── Audit log (SQLite) ───────────────────────────────────────
# SQLite file chỉ dùng cho audit log (tạo tự động nếu chưa có)
AUDIT_DB_PATH=./data/audit.db

# ── Storage paths ────────────────────────────────────────────
CHROMA_DIR=./data/chroma_db
BM25_PATH=./data/bm25_index.pkl
DOCS_JSONL=./data/raw/documents.jsonl
CHUNKS_JSONL=./data/raw/chunks.jsonl
FINETUNE_JSONL=./data/finetune/llm_data.jsonl
QA_FINETUNE_JSONL=./data/finetune/qa_finetuning.jsonl

# ── Config paths ─────────────────────────────────────────────
PROMPTS_DIR=./config/prompts
GUARDRAILS_YAML=./config/guardrails.yaml
SEED_SOURCES=./data/seed_sources.yaml

# ── API server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
# Dùng wildcard cho local dev; production dùng domain cụ thể
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
API_KEY=
RATE_LIMIT_PER_MINUTE=60
METRICS_ENABLED=true

# ── Crawler ──────────────────────────────────────────────────
USER_AGENT=AcneLLM-Bot/1.0 (student research)
CRAWL_CONCURRENCY=8
CRAWL_RATE_PER_SEC=1.0

# ── LLMData / Fine-tune dataset generator ───────────────────
# Điền API key vào .env (KHÔNG commit vào đây)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=o4-mini
JUDGE_REASONING_EFFORT=low
