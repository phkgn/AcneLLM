# ============================================================
# AcneLLM operational configuration template
# Copy to .env, then change machine-specific values there.
# Structural paths stay in src/acne_llm/config.py.
# Never commit real API keys.
# ============================================================

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=DEBUG                         # Console/file verbosity.

# ── LLM answer (7B) ──────────────────────────────────────────
OLLAMA_URL=http://localhost:11434       # Local Ollama API.
LLM_MODEL=acnellm-v2-q4                 # Main answer model.
LLM_FALLBACK_MODEL=qwen2.5:3b           # Load/generation fallback.
LLM_NUM_CTX=3072                        # Context window tokens.
LLM_NUM_PREDICT=1200                    # Maximum generated tokens.
LLM_TEMPERATURE=0.35                    # Answer sampling temperature.
LLM_TOP_P=0.85                          # Nucleus sampling cutoff.
LLM_TOP_K=40                            # Top-k sampling cutoff.
LLM_REPEAT_PENALTY=1.1                  # Repetition penalty.
LLM_REPEAT_LAST_N=128                   # Tokens covered by repetition check.
LLM_KEEP_ALIVE=-1                       # Ollama warm duration; -1 is persistent.
OLLAMA_HEALTH_TIMEOUT=5                 # Health-check timeout seconds.
OLLAMA_GENERATE_TIMEOUT=180             # Answer generation timeout seconds.
LLM_USE_MODELFILE_SYSTEM=true           # Use SYSTEM embedded in Modelfile.

# ── Unified intake (3B) ──────────────────────────────────────
INTAKE_MODE=unified                     # unified or legacy.
INTAKE_MODEL=acne-intake                # Unified route+extract model.
INTAKE_TIMEOUT=60                       # Unified intake timeout seconds.

# ── Legacy intake adapters ───────────────────────────────────
EXTRACTOR_MODE=llm                      # llm or rule; legacy mode only.
EXTRACTOR_MODEL=acne-extractor:1.5b     # Legacy extraction model.
EXTRACTOR_TIMEOUT=20                    # Legacy extractor timeout seconds.
ROUTER_MODE=llm                         # llm or semantic; legacy mode only.
ROUTER_MODEL=acnellm-intent             # Legacy generative router model.
ROUTER_TIMEOUT=8                        # Legacy router timeout seconds.

# ── Fallback router ──────────────────────────────────────────
SEMANTIC_ROUTER_K=9                     # Nearest neighbors used for voting.
SEMANTIC_ROUTER_OOS_DISTANCE_THRESHOLD=0.483609 # Soft OOS distance cutoff.
SEMANTIC_ROUTER_AMBIGUITY_MARGIN=0.08   # Minimum winning vote margin.

# ── RAG / retrieval ──────────────────────────────────────────
RETRIEVE_TOP_K=6                        # Generic retrieval candidate pool.
RERANK_TOP_K=3                          # Generic post-rerank results.
CHAT_RETRIEVE_TOP_K=6                   # Chat retrieval candidate pool.
CHAT_RERANK_TOP_K=3                     # Chat post-rerank results.
CHAT_RERANK_TOP_K_CLINICAL=5            # Results for clinical plans.
RETRIEVAL_SOURCE_BOOSTS={"nice_guideline":1.50,"aad_guideline":1.50,"jid_paper":1.30,"pubmed_review":1.20,"clinical_textbook":1.20,"vi_medical_site":1.00,"forum_post":0.80,"blog":0.70,"unknown":1.00} # Source-type weights.
RETRIEVAL_TRUST_BOOSTS={"high":1.40,"medium":1.00,"low":0.70} # Trust-tier weights.
RETRIEVAL_AUTHORITY_BOOST=1.15          # Authority metadata multiplier.
CHAT_MAX_CONTEXT_CHARS=6000             # RAG context character budget.
CHAT_SAFETY_TOP_K=5                     # Guideline pool for safety retrieval.
CHAT_RERANK_OOD_FLOOR=0.58              # Reject uniformly weak rerank pools.
CHAT_RERANK_KEEP_FLOOR=0.58             # Per-chunk weak-pool rescue floor.
DENSE_MAX_DISTANCE=0.60                 # Chroma cosine-distance cutoff.
BM25_NORMALIZE=true                     # Normalize sparse retrieval scores.
ENGLISH_INPUT_NOTICE=true               # Show notice for English input.

# ── Embedding / rerank ───────────────────────────────────────
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding # Primary embedding model.
EMBEDDING_MODEL_MULTILINGUAL=            # Optional multilingual override.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3  # Cross-encoder reranker.
DEVICE=cpu                              # cpu, cuda, cuda:N, mps, or auto.
RERANKER_BATCH_SIZE=16                  # Cross-encoder batch size.
RERANKER_CACHE_SIZE=2048                # Cached pair scores.
RERANKER_MIN_SIGMOID=0.30               # Per-chunk reranker threshold.

# ── Intake confidence thresholds ─────────────────────────────
EXTRACT_FUZZY_ACCEPT=0.86                # High-confidence fuzzy match.
EXTRACT_FUZZY_REVIEW=0.72                # Low-confidence review floor.
EXTRACT_MIN_FIELD_CONF=0.60             # Completeness field threshold.
EXTRACT_SAFETY_ACCEPT=0.78               # Safety-field recall threshold.
ROUTE_MIN_CONFIDENCE=0.55                # Clarify below this route score.

# ── Safety / guardrails ──────────────────────────────────────
GUARDRAILS_SCOPE_MODE=soft               # soft, hard, or off compatibility mode.

# ── Cache / session ──────────────────────────────────────────
CACHE_SIZE_GB=2.0                        # Disk cache limit; 0 disables cache.
SESSION_TTL=1800                         # Idle expiry seconds.
SESSION_HISTORY_CHAR_BUDGET=3000         # Prompt history character budget.
SESSION_MAX_HISTORY_TURNS=10             # Maximum stored prompt turns.

# ── API server ───────────────────────────────────────────────
API_HOST=0.0.0.0                         # Bind address.
API_PORT=8000                            # Bind port.
FRONTEND_URL=http://localhost:3000       # Frontend origin.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"] # Allowed origins.
API_KEY=                                 # Optional API bearer key.
RATE_LIMIT_PER_MINUTE=60                 # Per-client request budget.
METRICS_ENABLED=true                     # Expose runtime metrics.

# ── Crawler ──────────────────────────────────────────────────
CRAWL_CONCURRENCY=8                      # Concurrent fetches.
CRAWL_RATE_PER_SEC=1.0                   # Global request rate.
USER_AGENT=AcneLLM-Bot/1.0 (student research) # Crawler identity.

# ── Dataset / evaluation services (outside Settings schema) ──
DEEPSEEK_API_KEY=                         # Secret; set only in .env.
DEEPSEEK_BASE_URL=https://api.deepseek.com # DeepSeek API endpoint.
DEEPSEEK_MODEL=deepseek-chat              # Dataset generator model.
OPENAI_API_KEY=                           # Secret; set only in .env.
OPENAI_BASE_URL=https://api.openai.com/v1 # OpenAI-compatible endpoint.
JUDGE_MODEL=o4-mini                       # Evaluation judge model.
JUDGE_REASONING_EFFORT=low                # Judge reasoning effort.
