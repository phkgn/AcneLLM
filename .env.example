# LLM
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_FALLBACK_MODEL=qwen2.5:3b
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.3
OLLAMA_HEALTH_TIMEOUT=5
OLLAMA_GENERATE_TIMEOUT=180

# Embedding / Reranker
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cpu

# Storage
CHROMA_DIR=./data/chroma_db
BM25_PATH=./data/bm25_index.pkl
DOCS_JSONL=./data/raw/documents.jsonl
CHUNKS_JSONL=./data/raw/chunks.jsonl

# Paths
PROMPTS_DIR=./config/prompts
GUARDRAILS_YAML=./config/guardrails.yaml
SEED_SOURCES=./data/seed_sources.yaml

# Retrieval
RETRIEVE_TOP_K=20
RERANK_TOP_K=5
CHAT_RETRIEVE_TOP_K=8
CHAT_RERANK_TOP_K=3
CHAT_MAX_CONTEXT_CHARS=4500
CHAT_MIN_CITATION_SCORE=0.12
ENABLE_BILINGUAL_QUERY=true
ENGLISH_INPUT_NOTICE=true
QUERY_EXPANSION_TEMPERATURE=0.1

# API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["*"]
API_KEY=
RATE_LIMIT_PER_MINUTE=60
METRICS_ENABLED=true

# Crawler
USER_AGENT=AcneLLM-Bot/1.0 (student research)
CRAWL_CONCURRENCY=8
CRAWL_RATE_PER_SEC=1.0

# Fine-tuning dataset generator (LLMData/chunk_qa)
# DeepSeek is the synthetic Q&A generator.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OpenAI is the medical judge (default o4-mini reasoning model).
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=o4-mini
JUDGE_REASONING_EFFORT=low
