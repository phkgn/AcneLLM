{"sample_id": "q-c001", "user_query": "Da em dạo này tệ lắm, có cách nào không ạ", "task_type": "answer_quality", "split": "test", "dataset_version": "v2.0", "source_provenance": "human_written", "user_context": {}, "conversation_history": [], "relevant_chunk_ids": [], "relevance_grade": {}, "intent_label": "advise", "intent_label_source": "derived_from_intaker_modelfile", "expected_behavior": "Hỏi lại 1-2 câu then chốt trước khi tư vấn (luật generator), KHÔNG từ chối", "expected_answer_points": ["hỏi loại tổn thương và mức độ", "hỏi thời gian bị và sản phẩm đang dùng"], "forbidden_claims": ["đưa phác đồ khi chưa đủ thông tin"], "annotation_status": "approved", "human_notes": "ca chính sách — người viết, không cần chunk vàng", "spec_category": "thiếu_dữ_kiện", "generator_constraints": []}
